# ============================================================
# TheraCraft — environment variables
# Copy this file to `.env.local` and fill in the real values.
# NEVER commit `.env.local`. See DEVELOPER.md section 7–8 for how to get each.
# ============================================================

# --- MongoDB Atlas (required to save bookings) ---
# Connect → Drivers → copy the string, insert your password, add a db name.
MONGODB_URI="mongodb+srv://USER:PASSWORD@cluster.xxxxx.mongodb.net/theracraft?retryWrites=true&w=majority"

# --- Twilio WhatsApp (required to send messages) ---
# From the Twilio Console dashboard.
TWILIO_ACCOUNT_SID="ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
TWILIO_AUTH_TOKEN="your_twilio_auth_token"
# Sandbox number for testing, or your approved WhatsApp Business sender.
TWILIO_WHATSAPP_FROM="whatsapp:+14155238886"
# The clinic's WhatsApp number that receives new-booking alerts.
CLINIC_WHATSAPP_TO="whatsapp:+917204688546"

# --- Vercel Cron (protects the daily reminder endpoint) ---
# Any long random string; Vercel Cron sends it as `Authorization: Bearer <this>`.
CRON_SECRET="change_me_to_a_long_random_string"

# --- Google Places API (for LIVE Google reviews in the Testimonials section) ---
# A Google Cloud API key with "Places API" enabled, + the clinic's Place ID.
# If either is missing, the site shows sample reviews instead (never breaks).
GOOGLE_PLACES_API_KEY=""
GOOGLE_PLACE_ID=""

# --- Google Maps (OPTIONAL — embedded map; a plain iframe needs no key) ---
# NEXT_PUBLIC_GOOGLE_MAPS_KEY=""
